{
  "name": "3d-chess-server",
  "version": "1.0.0",
  "description": "Socket.IO server for 3D Chess multiplayer game",
  "main": "server.js",
  "scripts": {
    "start": "node server-enhanced.js",
    "dev": "nodemon server-enhanced.js",
    "test": "node test-client.js",
    "test:basic": "node test-client.js basic",
    "test:room": "node test-client.js room", 
    "test:move": "node test-client.js move",
    "docker:build": "docker build -t 3d-chess-server .",
    "docker:run": "docker run -p 3000:3000 3d-chess-server",
    "docker:dev": "docker-compose up",
    "deploy:heroku": "git push heroku main",
    "logs": "heroku logs --tail"
  },
  "keywords": [
    "socket.io",
    "chess",
    "multiplayer",
    "game-server",
    "unity"
  ],
  "author": "3D Chess Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "socket.io-client": "^4.7.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
